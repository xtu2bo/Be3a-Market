<section class="page-width product-page"><div class="product-detail"><div class="product-detail-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.title }}{% endif %}</div><div class="product-detail-copy"><p class="product-vendor">{{ product.vendor }}</p><h1>{{ product.title }}</h1><div class="detail-price">{{ product.price | money }}</div>{% form 'product', product %}{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% else %}<select name="id">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }} · {{ variant.price | money }}</option>{% endfor %}</select>{% endif %}<button class="button" type="submit">أضيفي للسلة</button>{% endform %}<div class="description">{{ product.description }}</div></div></div></section>
