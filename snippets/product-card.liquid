<article class="product-card"><a href="{{ product.url }}" class="product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span class="placeholder">بيعة</span>{% endif %}<span class="favorite">♡</span></a><div class="product-info"><p class="product-vendor">{{ product.vendor | default: shop.name }}</p><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="product-price">{{ product.price | money }}</div></div></article>
