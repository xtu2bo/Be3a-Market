<section class="products-section page-width">
  <div class="section-heading row"><div><p class="eyebrow">HANDPICKED FOR YOU</p><h2>{{ section.settings.title }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">كل الكولكشن ←</a></div>
  {% assign featured = collections[section.settings.collection] %}
  {% if featured != blank and featured.products_count > 0 %}<div class="product-grid">{% for product in featured.products limit: 8 %}{% render 'product-card', product: product %}{% endfor %}</div>{% else %}<div class="empty-products"><p>المنتجات هتظهر هنا أول ما تضيفيها من لوحة Shopify</p><a class="button" href="{{ routes.all_products_collection_url }}">تصفحي الكولكشن</a></div>{% endif %}
</section>
{% schema %}{"name":"منتجات مختارة","settings":[{"type":"text","id":"title","label":"العنوان","default":"عينك هتيجي عليهم"},{"type":"collection","id":"collection","label":"الكولكشن"}],"presets":[{"name":"منتجات مختارة"}]}{% endschema %}
