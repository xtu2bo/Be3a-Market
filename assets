document.addEventListener('DOMContentLoaded',()=>{const header=document.querySelector('[data-header]');const menu=document.querySelector('.menu-toggle');const panel=document.querySelector('#mobileMenu');const onScroll=()=>header?.classList.toggle('is-scrolled',window.scrollY>36);window.addEventListener('scroll',onScroll,{passive:true});onScroll();menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));panel.hidden=open;});});
